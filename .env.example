# LLM provider — any OpenAI-compatible API; the provider is configuration, not code.
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Set only when using a non-OpenAI provider:
# LLM_BASE_URL=https://api.example.com/v1

# Embeddings run locally by default (no key, no per-call cost).
# API fallback (slim image, see ADR-002/ADR-004):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
