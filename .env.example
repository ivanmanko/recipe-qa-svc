# LLM provider — any OpenAI-compatible API; the provider is configuration, not code.
# Defaults (see config.py) target DeepSeek: base_url https://api.deepseek.com,
# model deepseek-v4-flash, json_object output mode.
LLM_API_KEY=sk-...

# To use OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_SUPPORTS_JSON_SCHEMA=true

# Embeddings run locally by default (no key, no per-call cost).
# API fallback (slim image, see ADR-002/ADR-004):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
